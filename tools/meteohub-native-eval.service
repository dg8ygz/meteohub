[Unit]
Description=Meteohub native aggregation and queued full recomputation
Requires=meteohub-ram.service meteohub-live-runtime.service
After=meteohub-ram.service meteohub-live-runtime.service systemd-time-wait-sync.service
Wants=systemd-time-wait-sync.service
PartOf=meteohub-live.target
Before=shutdown.target

[Service]
Type=exec
User=1000
Group=1000
RootDirectory=/home/meteohub/meteohub-staging/5.1e-runtime/root
WorkingDirectory=/home/meteohub
MountAPIVFS=yes
BindReadOnlyPaths=/usr:/usr /usr/local/libexec/meteohub-native-eval:/opt/meteohub-native-eval
BindPaths=/run/meteohub-live-1000:/run
ReadWritePaths=+/home/meteohub +/data
ProtectSystem=strict
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
UMask=0077
MemoryMax=128M
TasksMax=16
CPUQuota=25%
Nice=10
LimitCORE=0
KillMode=control-group
TimeoutStopSec=15s
Restart=always
RestartSec=15s
ExecStart=/usr/bin/python3 /opt/meteohub-native-eval/native-eval.py daemon

[Install]
WantedBy=meteohub-live.target
